
# Set locally; do not commit real secrets.
BASIC_AUTH_PASSWORD=replace-with-controller-basic-auth-password
POSTGRES_PASSWORD=replace-with-postgres-password

# The default Compose worker runs the deterministic fake executor only.
# Set PUBLISH_EXECUTOR_MODE=truenas only for the separately approved LAN gate.
PUBLISH_EXECUTOR_MODE=fake
WORKER_POLL_INTERVAL_SECONDS=1
DRAMATIQ_WORKER_THREADS=2

# TrueNAS write profile. Keep disabled until the adapter read-back gate and
# one-station LAN smoke are explicitly approved.
TRUENAS_VERSION=25.10.5
TRUENAS_WS_URL=wss://192.168.0.21/api/current
TRUENAS_API_KEY=replace-with-truenas-api-key
# Keep verification enabled when TrueNAS uses a trusted certificate. For a
# short trusted-LAN smoke test with a self-signed certificate, set false.
TRUENAS_TLS_VERIFY=true
# Optional path inside the worker container to a trusted TrueNAS CA PEM file.
TRUENAS_TLS_CA_FILE=
TRUENAS_APPLY_ENABLED=false
